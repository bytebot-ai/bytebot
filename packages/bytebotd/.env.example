# Bytebot Desktop (bytebotd) Environment Variables
# Copy this file to .env and fill in the values

# ============================================================================
# X11 DISPLAY (Required for Desktop Environment)
# ============================================================================
# X11 display number for the virtual desktop
# Default: :0 (first display)
DISPLAY=:0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Server port (default: 9990)
# Serves both bytebotd API and noVNC websocket endpoint
# PORT=9990

# ============================================================================
# RESOURCE NOTES
# ============================================================================
# This service runs a full Ubuntu desktop environment including:
# - XFCE desktop
# - X11 server (Xvfb)
# - VNC server (x11vnc)
# - noVNC web client
# - Firefox ESR
# - VS Code
# - 1Password
# - Node.js 20
#
# Recommended resources:
# - Memory: 2GB minimum, 4GB recommended
# - CPU: 2 vCPU minimum
# - Disk: 2GB minimum
#
# Railway Plan Recommendation: Pro or higher for optimal performance
