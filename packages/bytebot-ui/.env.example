# Agent service URL (Required)
# Local: http://localhost:9991
# Railway: http://bytebot-agent.railway.internal:9991
BYTEBOT_AGENT_BASE_URL=http://localhost:9991

# Desktop VNC WebSocket URL (Required)
# Local: ws://localhost:9990/websockify
# Railway: ws://bytebot-desktop.railway.internal:9990/websockify
BYTEBOT_DESKTOP_VNC_URL=ws://localhost:9990/websockify

# Public API URL for browser (Required)
# Local: http://localhost:9991
# Railway: Use internal URL, Express server proxies requests
NEXT_PUBLIC_API_URL=http://localhost:9991

# Node environment (development | production)
# Railway: Set to production automatically
NODE_ENV=development

# Optional: Port override (default: 9992)
# PORT=9992

# Optional: Hostname (default: localhost, Railway: 0.0.0.0)
# HOSTNAME=0.0.0.0
